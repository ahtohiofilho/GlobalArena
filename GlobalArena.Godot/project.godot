; Engine configuration file.
; GA-VS02 — self-contained Godot GDScript visual probe for canonical C# world.
config_version=5

[application]
config/name="Global Arena — VS02 Globo Neolítico"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1320
window/size/viewport_height=820
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.044, 0.058, 1)
